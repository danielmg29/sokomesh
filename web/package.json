{
  "name": "sokomesh-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "contract:gen": "tsx tools/gen-contract.mts",
    "tokens:gen": "tsx tools/gen-tokens.mts",
    "gen": "pnpm contract:gen && pnpm tokens:gen",
    "dev": "pnpm gen && next dev",
    "build": "pnpm gen && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "pnpm gen && git diff --exit-code -- lib/contract/generated.ts lib/design/tokens.generated.ts app/tokens.generated.css && pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-virtual": "^3.14.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "jotai": "^3.0.1",
    "lucide-react": "1.55.0",
    "next": "16.4.0",
    "radix-ui": "1.8.0",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "culori": "^4.0.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.24.0"
}
