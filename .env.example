# Copied to .env by `just bootstrap`. Read by Django settings, docker compose and just.
# Values here are for local development only.

DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Host-side URLs (uv run ...). Compose overrides these with in-network hosts.
DATABASE_URL=postgres://sokomesh:sokomesh@localhost:5433/sokomesh
REDIS_URL=redis://localhost:6379/0

# Registration mode exported into the contract: single | multi; verification: email, sms
AC_AUTH_MODE=multi
AC_VERIFY=email

# Tests use this database, never DATABASE_URL (which may be a hosted one). Defaults to the compose Postgres.
# TEST_DATABASE_URL=postgres://sokomesh:sokomesh@localhost:5433/sokomesh

# Email. With a Brevo API key, mail is sent through Brevo's transactional API from a sender verified in
# Brevo; without one, development mail goes to Mailpit (http://localhost:8025).
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=SokoMesh <no-reply@your-verified-domain>

# Lists the seeded demo accounts (and their shared password) on the sign-in page. On in development only.
# AC_DEMO_ACCOUNTS=true

# Web. The API path comes from the contract (meta.apiBase); only the origin is configured.
# API_ORIGIN is what the Next.js server uses (rewrites and server-rendered storefront data).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_ORIGIN=http://localhost:8000
# API_ORIGIN=http://localhost:8000
